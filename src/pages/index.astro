---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import logo from '../assets/logo.webp';
import portada from '../assets/img/portada-condensadores.jpg';
import { empresa, servicios, equipos, preguntas, nosotros } from '../data/empresa';

const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/img/*.jpg', { eager: true });
const foto = (nombre: string) => fotos[`../assets/img/${nombre}`].default;

const tel = `tel:${empresa.telefonoE164}`;
const wa = `https://wa.me/${empresa.whatsapp}`;
const mapa = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${empresa.direccion}, ${empresa.ciudad}, ${empresa.departamento}`)}`;
const flecha = '<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<Base
  titulo="Aire acondicionado en Cali: instalación, mantenimiento y reparación | Refriconfort Cool"
  descripcion={`Instalación, mantenimiento y reparación de aires acondicionados y refrigeración en Cali. Ductería y filtros. Cotiza por WhatsApp al ${empresa.telefono}.`}
>
  <a class="saltar boton boton--marca" href="#contenido">Saltar al contenido</a>

  <div class="franja">
    <div class="contenedor franja__fila dato">
      <a class="franja__dir" href={mapa} rel="noopener">{empresa.direccion} · {empresa.ciudad}, {empresa.departamento}</a>
      <span class="franja__acciones">
        <a href={tel}>Tel. {empresa.telefono}</a>
        <a href={wa} rel="noopener">WhatsApp {empresa.whatsappTexto}</a>
      </span>
    </div>
  </div>

  <header class="cabecera">
    <div class="contenedor cabecera__fila">
      <a class="marca" href={import.meta.env.BASE_URL}>
        <Image src={logo} alt="Refriconfort Cool S.A.S., inicio" width={180} densities={[1, 2]} loading="eager" />
      </a>
      <nav aria-label="Principal">
        <ul class="menu">
          <li><a href="#servicios">Servicios</a></li>
          <li><a href="#equipos">Equipos</a></li>
          <li><a href="#mantenimiento">Mantenimiento</a></li>
          <li><a href="#nosotros">Nosotros</a></li>
          <li><a href="#preguntas">Preguntas</a></li>
          <li><a class="boton boton--marca menu__cotizar" href="#cotizar">Cotizar</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="contenido">
    <section class="portada" aria-labelledby="titulo-portada">
      <Image class="portada__foto" src={portada} alt="" widths={[800, 1200, 1600]} sizes="100vw" loading="eager" fetchpriority="high" />
      <svg class="aire" viewBox="0 0 1200 400" preserveAspectRatio="none" aria-hidden="true">
        <path d="M-50 60 C 200 10, 400 110, 650 60 S 1050 10, 1250 60" />
        <path d="M-50 140 C 220 90, 420 190, 670 140 S 1070 90, 1250 140" />
        <path d="M-50 220 C 180 170, 380 270, 630 220 S 1030 170, 1250 220" />
        <path d="M-50 300 C 240 250, 440 350, 690 300 S 1090 250, 1250 300" />
      </svg>

      <div class="contenedor portada__rejilla">
        <div class="portada__texto">
          <p class="dato portada__ubicacion">Cali · Valle del Cauca</p>
          <h1 id="titulo-portada">Aire acondicionado y&nbsp;refrigeración en Cali</h1>
          <p class="portada__bajada">
            Instalamos, reparamos y mantenemos equipos en casas, oficinas y locales.
            También diseñamos y fabricamos ductería.
          </p>

          <div class="termostato" role="img" aria-label="Afuera en Cali 32 grados; adentro, con el aire encendido, 22 grados">
            <div><span class="dato">Afuera</span><strong data-temp-afuera>32°</strong></div>
            <svg class="termostato__flecha" width="40" height="16" viewBox="0 0 40 16" aria-hidden="true"><path d="M0 8h34M28 2l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.5"/></svg>
            <div><span class="dato">Adentro</span><strong class="termostato__frio" data-temp-adentro>22°</strong></div>
          </div>

          <div class="portada__botones">
            <a class="boton boton--sol" href="#cotizar">Pedir cotización <Fragment set:html={flecha} /></a>
            <a class="boton boton--claro" href={tel}>Llamar {empresa.telefono}</a>
          </div>
        </div>

        <aside class="etiqueta" aria-labelledby="titulo-etiqueta" data-dias={empresa.mantenimientoDias}>
          <p class="etiqueta__cabeza dato"><span>Etiqueta de servicio</span><span aria-hidden="true">N.º 0001</span></p>
          <h2 id="titulo-etiqueta" class="etiqueta__titulo">Próximo mantenimiento</h2>
          <dl class="etiqueta__campos">
            <div><dt class="dato">Si lo haces hoy</dt><dd class="dato" data-hoy>—</dd></div>
            <div><dt class="dato">El siguiente</dt><dd class="dato etiqueta__fecha" data-proximo>en {empresa.mantenimientoDias} días</dd></div>
          </dl>
          <p class="etiqueta__nota">Recomendamos mantenimiento preventivo <strong>cada dos meses</strong>.</p>
          <a class="boton boton--marca etiqueta__boton" href="#cotizar" data-servicio="Mantenimiento preventivo">Agendar mantenimiento</a>
        </aside>
      </div>
    </section>

    <section id="servicios" class="seccion contenedor" aria-labelledby="titulo-servicios">
      <div class="seccion__cabeza" data-revelar>
        <h2 id="titulo-servicios" class="seccion__titulo">Servicios</h2>
        <p class="seccion__bajada">Del diseño a la reparación, en hogar y en comercio.</p>
      </div>
      <ol class="servicios">
        {servicios.map((s, i) => (
          <li class="servicio" data-revelar style={`--i:${i % 3}`}>
            <div class="servicio__foto">
              <Image src={foto(s.img)} alt="" widths={[400, 700]} sizes="(min-width: 60rem) 24rem, (min-width: 40rem) 50vw, 100vw" />
              <span class="dato servicio__codigo">{s.codigo}</span>
            </div>
            <h3 class="servicio__nombre">{s.nombre}</h3>
            <p class="servicio__detalle">{s.detalle}</p>
          </li>
        ))}
      </ol>
    </section>

    <section id="equipos" class="equipos" aria-labelledby="titulo-equipos">
      <div class="contenedor">
        <div class="seccion__cabeza" data-revelar>
          <h2 id="titulo-equipos" class="seccion__titulo">Equipos que atendemos</h2>
          <p class="seccion__bajada">Residenciales, comerciales e industriales.</p>
        </div>
        <ul class="equipos__lista">
          {equipos.map((e, i) => (
            <li class="equipo" data-revelar="escala" style={`--i:${i % 4}`}>
              <Image src={foto(e.img)} alt={`Equipo ${e.nombre}`} widths={[240, 400]} sizes="(min-width: 60rem) 16rem, 45vw" />
              <span class="dato equipo__nombre">{e.nombre}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="mantenimiento" class="frio" aria-labelledby="titulo-mant">
      <div class="contenedor frio__rejilla">
        <div class="frio__cabeza" data-revelar="izquierda">
          <svg class="ventilador" viewBox="0 0 100 100" aria-hidden="true">
            <circle cx="50" cy="50" r="47" fill="none" stroke="currentColor" stroke-width="3" />
            <g class="ventilador__aspas">
              <path d="M50 50 C 40 30, 45 12, 58 8 C 66 20, 62 38, 50 50Z" />
              <path d="M50 50 C 40 30, 45 12, 58 8 C 66 20, 62 38, 50 50Z" transform="rotate(120 50 50)" />
              <path d="M50 50 C 40 30, 45 12, 58 8 C 66 20, 62 38, 50 50Z" transform="rotate(240 50 50)" />
            </g>
            <circle cx="50" cy="50" r="7" />
          </svg>
          <h2 id="titulo-mant" class="seccion__titulo">Por qué cada dos meses</h2>
        </div>
        <ul class="frio__puntos">
          <li data-revelar style="--i:0"><span class="dato">Filtros</span><p>Retienen polvo fino y alérgenos. Sucios, dejan pasar aire contaminado y obligan al equipo a trabajar de más.</p></li>
          <li data-revelar style="--i:1"><span class="dato">Consumo</span><p>Un equipo limpio enfría más rápido y gasta menos energía. Uno de 10 años sin cuidado puede ser hasta 60 % menos eficiente.</p></li>
          <li data-revelar style="--i:2"><span class="dato">Fallas</span><p>Goteos, congelamiento y ruidos se detectan antes de que obliguen a una reparación costosa.</p></li>
        </ul>
      </div>
    </section>

    <section id="nosotros" class="seccion contenedor nosotros" aria-labelledby="titulo-nosotros">
      <div class="nosotros__texto" data-revelar="izquierda">
        <h2 id="titulo-nosotros" class="seccion__titulo">Quiénes somos</h2>
        <p class="nosotros__resumen">{nosotros.resumen}</p>
        <p>{nosotros.equipo}</p>
        <blockquote class="nosotros__mision">
          <span class="dato">Nuestra misión</span>
          <p>{nosotros.mision}</p>
        </blockquote>
      </div>
      <ul class="valores">
        {nosotros.valores.map((v, i) => (
          <li class="valor" data-revelar style={`--i:${i}`}>
            <span class="dato valor__num">0{i + 1}</span>
            <h3 class="valor__nombre">{v.nombre}</h3>
            <p>{v.texto}</p>
          </li>
        ))}
      </ul>
    </section>

    <section id="cotizar" class="seccion contenedor cotizar" aria-labelledby="titulo-cotizar">
      <div class="cotizar__intro" data-revelar="izquierda">
        <h2 id="titulo-cotizar" class="seccion__titulo">Pide tu cotización</h2>
        <p>Llena lo que sepas y te llega como mensaje de WhatsApp. Te respondemos por ahí.</p>
        <p class="dato cotizar__alterno">
          ¿Prefieres otro medio?<br />Tel. <a href={tel}>{empresa.telefono}</a> · WhatsApp <a href={wa} rel="noopener">{empresa.whatsappTexto}</a><br /><a href={`mailto:${empresa.correo}`}>{empresa.correo}</a>
        </p>
      </div>

      <form class="formulario" id="formulario" data-whatsapp={empresa.whatsapp} novalidate data-revelar>
        <label class="campo"><span>Nombre *</span><input name="nombre" autocomplete="name" required /></label>
        <label class="campo"><span>Teléfono *</span><input name="telefono" type="tel" autocomplete="tel" inputmode="tel" required /></label>
        <label class="campo"><span>Barrio o ciudad</span><input name="barrio" autocomplete="address-level2" /></label>
        <fieldset class="campo campo--opciones">
          <legend>Es para</legend>
          <label><input type="radio" name="tipo" value="Hogar" checked /> Hogar</label>
          <label><input type="radio" name="tipo" value="Negocio" /> Negocio</label>
        </fieldset>
        <label class="campo">
          <span>Servicio</span>
          <select name="servicio">
            {servicios.map((s) => <option>{s.nombre}</option>)}
            <option>Otro</option>
          </select>
        </label>
        <label class="campo">
          <span>Equipo</span>
          <select name="equipo">
            <option value="">No sé / varios</option>
            {equipos.map((e) => <option>{e.nombre}</option>)}
          </select>
        </label>
        <label class="campo campo--ancho"><span>Cuéntanos qué necesitas</span><textarea name="detalle" rows="4" placeholder="Ej.: 2 mini split de 12.000 BTU, uno gotea."></textarea></label>
        <p class="formulario__error" role="alert" hidden>Escribe tu nombre y un teléfono para poder contactarte.</p>
        <button class="boton boton--marca campo--ancho" type="submit">Enviar por WhatsApp <Fragment set:html={flecha} /></button>
        <p class="formulario__aviso campo--ancho">Usamos tus datos solo para responder esta solicitud.</p>
      </form>
    </section>

    <section id="preguntas" class="seccion contenedor" aria-labelledby="titulo-preguntas">
      <h2 id="titulo-preguntas" class="seccion__titulo" data-revelar>Preguntas frecuentes</h2>
      <div class="preguntas">
        {preguntas.map((q, i) => (
          <details data-revelar style={`--i:${i}`}>
            <summary>{q.p}</summary>
            <p>{q.r}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <footer class="pie">
    <div class="contenedor pie__rejilla">
      <div>
        <Image class="pie__logo" src={logo} alt="Refriconfort Cool S.A.S." width={220} densities={[1, 2]} />
        <p class="dato">{empresa.razonSocial} · NIT {empresa.nit}</p>
        <p class="pie__lema">Aire acondicionado, refrigeración y ductería en {empresa.ciudad} y el {empresa.departamento}.</p>
      </div>
      <nav aria-label="Pie de página">
        <p class="dato pie__titulo">Secciones</p>
        <ul class="pie__enlaces">
          <li><a href="#servicios">Servicios</a></li>
          <li><a href="#equipos">Equipos</a></li>
          <li><a href="#nosotros">Quiénes somos</a></li>
          <li><a href="#preguntas">Preguntas frecuentes</a></li>
          <li><a href="#cotizar">Cotizar</a></li>
        </ul>
      </nav>
      <address class="dato pie__datos">
        <span class="pie__titulo">Contacto</span><br />
        <a href={mapa} rel="noopener">{empresa.direccion}, {empresa.ciudad}</a><br />
        Tel. <a href={tel}>{empresa.telefono}</a><br />
        WhatsApp <a href={wa} rel="noopener">{empresa.whatsappTexto}</a><br />
        <a href={`mailto:${empresa.correo}`}>{empresa.correo}</a>
      </address>
    </div>
    <p class="contenedor dato pie__legal">© {new Date().getFullYear()} {empresa.razonSocial}</p>
  </footer>

  <a class="wa-flotante" href={wa} rel="noopener" aria-label="Escríbenos por WhatsApp">
    <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.1 5.1 0 0 0 1.1 2.7 11.7 11.7 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
  </a>

  <script>
    import { enlaceWhatsApp, proximoMantenimiento } from '../lib/mensaje.ts';

    const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Etiqueta: fechas de hoy y del próximo mantenimiento
    const fmt = new Intl.DateTimeFormat('es-CO', { day: '2-digit', month: '2-digit', year: 'numeric' });
    const hoy = new Date();
    const dias = Number(document.querySelector<HTMLElement>('.etiqueta')!.dataset.dias);
    document.querySelector('[data-hoy]')!.textContent = fmt.format(hoy);
    document.querySelector('[data-proximo]')!.textContent = fmt.format(proximoMantenimiento(hoy, dias));

    // Termostato: baja de 32° a 22° como si el aire acabara de encenderse
    const adentro = document.querySelector<HTMLElement>('[data-temp-adentro]')!;
    if (!quieto) {
      let t = 32;
      adentro.textContent = `${t}°`;
      const bajar = setInterval(() => {
        adentro.textContent = `${--t}°`;
        if (t <= 22) clearInterval(bajar);
      }, 180);
    }

    // Aparición al hacer scroll
    const obs = new IntersectionObserver((entradas) => {
      for (const e of entradas) if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); }
    }, { rootMargin: '0px 0px -10% 0px' });
    document.querySelectorAll('[data-revelar]').forEach((el) => obs.observe(el));

    // Formulario → WhatsApp
    const form = document.querySelector<HTMLFormElement>('#formulario')!;
    const error = form.querySelector<HTMLElement>('.formulario__error')!;
    document.querySelectorAll<HTMLAnchorElement>('[data-servicio]').forEach((a) =>
      a.addEventListener('click', () => { form.servicio.value = a.dataset.servicio; }),
    );
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(form);
      const v = (k: string) => String(d.get(k) ?? '');
      if (!v('nombre').trim() || v('telefono').replace(/\D/g, '').length < 7) {
        error.hidden = false;
        (v('nombre').trim() ? form.telefono : form.nombre).focus();
        return;
      }
      error.hidden = true;
      window.open(enlaceWhatsApp(form.dataset.whatsapp!, {
        nombre: v('nombre'), telefono: v('telefono'), barrio: v('barrio'), tipo: v('tipo'),
        servicio: v('servicio'), equipo: v('equipo'), detalle: v('detalle'),
      }), '_blank', 'noopener');
    });
  </script>
</Base>

<style>
  .saltar { position: absolute; left: var(--e-2); top: -100px; z-index: 20; }
  .saltar:focus { top: var(--e-2); }

  .franja { background: var(--noche); color: #fff; }
  .franja__fila { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--e-1) var(--e-3); padding-block: var(--e-1); }
  .franja__acciones { display: flex; gap: var(--e-3); }
  .franja a { color: var(--cielo-claro); }
  .franja__acciones a { white-space: nowrap; }
  @media (max-width: 40rem) {
    .franja__dir { display: none; }
    .franja__acciones { flex-wrap: wrap; gap: var(--e-1) var(--e-2); }
  }

  .cabecera { background: var(--superficie); position: sticky; top: 0; z-index: 10; box-shadow: 0 1px 0 var(--linea); }
  .cabecera::after { content: ''; display: block; height: 4px; background: var(--degradado-marca); }
  .cabecera__fila { display: flex; align-items: center; justify-content: space-between; gap: var(--e-2); padding-block: var(--e-1); }
  .marca img { width: clamp(130px, 22vw, 180px); }
  .menu { list-style: none; display: flex; align-items: center; gap: var(--e-3); margin: 0; padding: 0; }
  .menu a:not(.boton) {
    color: var(--tinta); text-decoration: none; font-weight: 650; font-stretch: 85%; text-transform: uppercase;
    letter-spacing: 0.04em; font-size: var(--paso-m1); padding-block: var(--e-2); display: inline-block;
    background: linear-gradient(var(--cian), var(--cian)) no-repeat left bottom / 0 3px;
    transition: background-size 220ms var(--curva), color 220ms var(--curva);
  }
  .menu a:not(.boton):hover { color: var(--indigo); background-size: 100% 3px; }
  .menu__cotizar { min-height: 42px; padding-block: var(--e-1); font-size: var(--paso-m1); }
  @media (max-width: 48rem) { .menu li:not(:last-child) { display: none; } }

  /* Portada: foto del sitio actual bajo el degradado del logo */
  .portada { position: relative; isolation: isolate; color: #fff; overflow: hidden; }
  .portada__foto { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; animation: acercar 18s var(--curva) both; }
  .portada::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(100deg, rgb(22 26 58 / 0.94) 0%, rgb(62 64 150 / 0.88) 38%, rgb(42 102 180 / 0.55) 70%, rgb(11 155 223 / 0.25) 100%);
  }
  @keyframes acercar { from { transform: scale(1.12); } to { transform: scale(1); } }

  /* Corrientes de aire frío que cruzan la portada */
  .aire { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; pointer-events: none; }
  .aire path { fill: none; stroke: var(--cielo-claro); stroke-width: 2; stroke-linecap: round; opacity: 0.35; stroke-dasharray: 120 260; animation: soplar 7s linear infinite; }
  .aire path:nth-child(2) { animation-duration: 9s; animation-delay: -3s; opacity: 0.25; }
  .aire path:nth-child(3) { animation-duration: 6s; animation-delay: -1s; }
  .aire path:nth-child(4) { animation-duration: 10s; animation-delay: -5s; opacity: 0.2; }
  @keyframes soplar { to { stroke-dashoffset: -760; } }

  .portada__rejilla { display: grid; gap: var(--e-8); align-items: center; padding-block: var(--e-13) var(--e-21); }
  @media (min-width: 60rem) { .portada__rejilla { grid-template-columns: 1.5fr 1fr; } }
  .portada__ubicacion { color: var(--cielo-claro); margin-bottom: var(--e-2); animation: entrar 700ms var(--curva) both; }
  .portada h1 { font-size: var(--paso-5); font-stretch: 62%; font-weight: 820; max-width: 14ch; animation: entrar 700ms 80ms var(--curva) both; }
  .portada__bajada { font-size: var(--paso-1); line-height: 1.45; max-width: 38ch; margin-top: var(--e-3); color: rgb(255 255 255 / 0.9); animation: entrar 700ms 160ms var(--curva) both; }
  .portada__botones { display: flex; flex-wrap: wrap; gap: var(--e-2); margin-top: var(--e-5); animation: entrar 700ms 320ms var(--curva) both; }
  @keyframes entrar { from { opacity: 0; transform: translateY(18px); } }

  /* Termostato: pantalla del control remoto */
  .termostato {
    display: inline-flex; align-items: center; gap: var(--e-3); margin-top: var(--e-5);
    padding: var(--e-2) var(--e-3); border: 1.5px solid rgb(255 255 255 / 0.35); border-radius: var(--radio);
    background: rgb(22 26 58 / 0.45); animation: entrar 700ms 240ms var(--curva) both;
  }
  .termostato div { display: grid; line-height: 1.1; }
  .termostato span { text-transform: uppercase; color: rgb(255 255 255 / 0.75); }
  .termostato strong { font-family: var(--f-dato); font-weight: 500; font-size: var(--paso-3); font-variant-numeric: tabular-nums; }
  .termostato__frio { color: var(--cielo-claro); }
  .termostato__flecha { color: var(--cielo-claro); }

  /* La etiqueta amarilla que el técnico pega en el equipo después del servicio */
  .etiqueta {
