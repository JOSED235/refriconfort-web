  .valores { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--e-3); grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); }
  .valor { background: var(--superficie); padding: var(--e-3); border-radius: var(--radio); border-top: 5px solid var(--cian); box-shadow: var(--sombra-foto); }
